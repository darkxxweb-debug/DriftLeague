<!DOCTYPE html>
<html lang="en">
<head>
  <title>DriftLeague · Race</title>
  <%- include('partials/head') %>
</head>
<body>
  <a href="/" class="nav-back"><i class="fa-solid fa-xmark"></i></a>

  <div class="rotate-overlay race-mode" id="rotateOverlay">
    <i class="fa-solid fa-mobile-screen-button"></i>
    <h2 class="page-title">Rotate your phone</h2>
    <p class="page-sub" style="margin-bottom:0;">DriftLeague is played in landscape. Turn your device sideways to race.</p>
  </div>

  <div id="raceWrap">
    <canvas id="raceCanvas"></canvas>

    <div class="hud">
      <div class="hud-top">
        <div class="hud-chip" id="lapChip">LAP 1/3</div>
        <div class="hud-chip" id="timeChip">00:00.0</div>
        <div class="hud-chip" id="posChip">POS 1</div>
      </div>
      <div class="hud-speed">
        <div class="val" id="speedVal">0</div>
        <div class="unit">KM/H</div>
      </div>
    </div>

    <div class="touch-controls">
      <div class="touch-steer">
        <div class="touch-btn" id="btnLeft"><i class="fa-solid fa-caret-left"></i></div>
        <div class="touch-btn" id="btnRight"><i class="fa-solid fa-caret-right"></i></div>
      </div>
      <div class="touch-gas">
        <div class="touch-btn" id="btnGas"><i class="fa-solid fa-gauge-high"></i></div>
        <div class="touch-btn" id="btnBrake"><i class="fa-solid fa-hand"></i></div>
      </div>
    </div>

    <div class="countdown-overlay" id="raceCountdown" style="display:none;"></div>

    <div class="results-overlay" id="resultsOverlay">
      <div class="results-card">
        <h2 class="page-title" style="margin-bottom:14px;">Race results</h2>
        <div id="resultsList"></div>
        <a href="/" class="btn btn-primary" style="margin-top:16px;">Back to lobby</a>
      </div>
    </div>
  </div>

  <script>
    window.ROOM_CODE = "<%= code %>";
  </script>
  <script src="/js/race/track.js"></script>
  <script src="/js/race/render.js"></script>
  <script src="/js/race/controls.js"></script>
  <script src="/js/race/game.js"></script>
</body>
</html>
